# Copy to .env.local and fill in from Supabase → Project Settings → API
# Never commit .env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Canonical public origin for OAuth redirectTo (required in production).
# Local dev can omit this (falls back to window.location.origin).
# NEXT_PUBLIC_APP_URL=https://focusup.base-db.com

# Google OAuth is configured in Supabase Dashboard + Google Cloud Console
# (no Google client secret in this file). Local callback:
# http://localhost:3000/auth/callback

# If Node cannot reach *.supabase.co (fetch failed / ECONNRESET), point at your
# local HTTP or SOCKS proxy so the Next.js server can exchange the OAuth code:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:10808
